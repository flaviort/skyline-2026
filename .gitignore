# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/settings.json

# wp
wp-vet/

# dev-only placeholders taken from the reference site, never committed
/public/_ref/

# 3D source files from the designer (large); the optimized .glb lives in public/models/
/assets/3d/

# review screenshots from impeccable checks (regenerated on demand)
/.impeccable/review/

# Screenshots and other scratch output from review sessions
/_temp/
